GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LOCAL_DATABASE_URL=file:./dev.db

# Firebase project settings (Project settings > General > Your apps > Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service-account credentials (Firebase console > Project settings > Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Server only: Ably app API key; never prefix NEXT_PUBLIC_
ABLY_API_KEY=

# Vercel Cron (server only): long, random secret
CRON_SECRET=
# Comma-separated app user IDs with admin permissions
COMMUNITY_ADMIN_USER_IDS=
