
# ==========================================
# QuizVerse AI - .gitignore
# ==========================================

# Dependencies
node_modules/

# Next.js
.next/
out/
build/
dist/

# Environment variables & secrets
.env
.env.*
!.env.example

# Firebase credentials
*service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json

# Private keys & certificates
*.pem
*.key
*.p12
*.pfx

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Unit Test & Coverage
coverage/
.nyc_output/

# Playwright E2E
playwright-report/
test-results/
playwright/.cache/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# IDE / Editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
