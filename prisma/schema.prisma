generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("LOCAL_DATABASE_URL")
}

model Quiz {
  id         String   @id
  ownerId    String
  title      String
  topic      String
  difficulty String
  questions  String   // JSON; schema checked on API boundary
  demo       Boolean  @default(false)
  createdAt  DateTime @default(now())
  visibility String @default("private")
  attempts   Attempt[]

  @@index([ownerId, createdAt])
}

model Attempt {
  id         String   @id
  ownerId    String
  quizId     String
  title      String
  score      Int
  total      Int
  finishedAt DateTime @default(now())
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([ownerId, finishedAt])
}


model User {
  id String @id
  email String @unique
  firebaseUid String? @unique
  name String
  passwordHash String
  createdAt DateTime @default(now())
  emailVerifiedAt DateTime?
  sessions Session[]
  emailVerificationTokens EmailVerificationToken[]
}

model Session {
  id String @id
  userId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id String @id
  userId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  id        String @id
  hits      Int
  expiresAt Int
  @@index([expiresAt])
}


// Phase 5: topic-level mastery and revision history. Previous quiz/attempt tables remain untouched.
model TopicMastery {
  id          String   @id
  ownerId     String
  topic       String
  answered    Int      @default(0)
  correct     Int      @default(0)
  strength    Float    @default(0)
  streak      Int      @default(0)
  nextReview  DateTime @default(now())
  updatedAt   DateTime @default(now())
  @@unique([ownerId, topic])
  @@index([ownerId, nextReview])
}

model ReviewCard {
  id          String   @id
  ownerId     String
  topic       String
  question    String
  options     String
  correctIndex Int
  explanation String
  intervalDays Int      @default(1)
  repetitions Int      @default(0)
  nextReview  DateTime @default(now())
  updatedAt   DateTime @default(now())
  @@unique([ownerId, id])
  @@index([ownerId, nextReview])
}

model LearningSubmission {
  attemptId   String   @id
  ownerId     String
  createdAt   DateTime @default(now())
  @@index([ownerId, createdAt])
}


// Phase 6: community, achievements, server-authoritative multiplayer.
model PlayerProfile {
  userId String @id
  xp Int @default(0)
  level Int @default(1)
  wins Int @default(0)
  games Int @default(0)
  updatedAt DateTime @updatedAt
}
model PlayerAchievement {
  id String @id
  userId String
  code String
  createdAt DateTime @default(now())
  @@unique([userId,code])
  @@index([userId])
}
model QuizRoom {
  id String @id
  code String @unique
  quizId String
  hostId String
  state String @default("lobby")
  questionIndex Int @default(0)
  secondsPerQuestion Int @default(30)
  maxParticipants Int @default(10)
  startedAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  participants RoomParticipant[]
  answers RoomAnswer[]
  @@index([hostId])
}
model RoomParticipant {
  id String @id
  roomId String
  userId String
  displayName String
  score Int @default(0)
  finished Boolean @default(false)
  joinedAt DateTime @default(now())
  room QuizRoom @relation(fields:[roomId],references:[id],onDelete:Cascade)
  @@unique([roomId,userId])
}
model RoomAnswer {
  id String @id
  roomId String
  userId String
  questionIndex Int
  choiceIndex Int
  correct Boolean
  answeredAt DateTime @default(now())
  room QuizRoom @relation(fields:[roomId],references:[id],onDelete:Cascade)
  @@unique([roomId,userId,questionIndex])
}

// Community safety: reports are private and owned by the reporter.
model QuizReport {
 id String @id
 quizId String
 reporterId String
 reason String
 createdAt DateTime @default(now())
 @@unique([quizId,reporterId])
 @@index([quizId,createdAt])
}
